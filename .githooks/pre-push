#!/bin/sh
# Blocks pushes with a foreign identity, trailers or red gates.
set -eu

expected=$(git config --get velve.identity || true)
if [ -z "$expected" ]; then
  echo "pre-push: no commit identity configured." >&2
  echo "pre-push: ask the repository owner, then run: git config velve.identity 'Name <email>'" >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for commit in $commits; do
    author=$(git log -1 --format='%an <%ae>' "$commit")
    committer=$(git log -1 --format='%cn <%ce>' "$commit")
    short=$(git log -1 --format='%h %s' "$commit")
    if [ "$author" != "$expected" ] || [ "$committer" != "$expected" ]; then
      echo "pre-push: $short has identity $author / $committer" >&2
      failed=1
    fi
    if git log -1 --format='%b' "$commit" | grep -Eq '^[A-Za-z-]+: |Generated with' ||
      git log -1 --format='%B' "$commit" | grep -Eiq 'co-authored-by|signed-off-by|claude-session'; then
      echo "pre-push: $short carries a trailer or attribution line" >&2
      failed=1
    fi
    if git notes list "$commit" >/dev/null 2>&1; then
      echo "pre-push: $short has a git note attached" >&2
      failed=1
    fi
  done
done

if [ "$failed" -ne 0 ]; then
  exit 1
fi

pnpm verify
