# Builds the waitlist as a slim standalone Node image.
FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN npm install --global --ignore-scripts "$(node -p "require('./package.json').packageManager")"
RUN pnpm install --frozen-lockfile

FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json ./
RUN npm install --global --ignore-scripts "$(node -p "require('./package.json').packageManager")"
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8674 HOSTNAME=0.0.0.0
RUN addgroup -S -g 10001 velve && adduser -S -u 10001 -G velve velve
COPY --from=build --chown=velve:velve /app/.next/standalone ./
COPY --from=build --chown=velve:velve /app/.next/static ./.next/static
COPY --from=build --chown=velve:velve /app/public ./public
USER velve
EXPOSE 8674
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8674/api/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "server.js"]
