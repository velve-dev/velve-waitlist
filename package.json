{
  "name": "velve-waitlist",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 8674",
    "build": "node scripts/check-legal.ts && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start --port 8674",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 . && knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "copy:lint": "node scripts/copy-lint.ts",
    "comments:lint": "node scripts/comments-lint.ts",
    "secrets:lint": "node scripts/secrets-lint.ts",
    "emails:check": "node scripts/emails-check.ts",
    "emails:build": "node scripts/emails-check.ts --write",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm comments:lint && pnpm secrets:lint && pnpm copy:lint && pnpm test && pnpm emails:check && pnpm build && pnpm e2e",
    "assets:build": "node scripts/render-assets.ts",
    "docker:check": "sh scripts/docker-check.sh"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
